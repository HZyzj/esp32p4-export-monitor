+void app_lcd_draw(uint8_t *buf, uint32_t len, uint16_t width, uint16_t height)
+{
+    lcd_frame_result_t result = app_lcd_decode_and_draw(buf, len, width, height);
+#if CONFIG_EXAMPLE_ENABLE_PRINT_FPS_RATE_VALUE
+    static uint32_t total[LCD_FRAME_RESULT_COUNT];
+    static uint32_t submitted_in_interval;
+    static int64_t interval_start_us;
+    int64_t now = esp_timer_get_time();
+    if (interval_start_us == 0) {
+        interval_start_us = now;
+    }
+    total[result]++;
+    submitted_in_interval += result == LCD_FRAME_SUBMITTED;
+    int64_t elapsed_us = now - interval_start_us;
+    if (elapsed_us >= 5000000) {
+        ESP_LOGI(TAG, "LCD submissions: %.1f fps, total=%" PRIu32
+                 ", jpeg_errors=%" PRIu32 ", draw_errors=%" PRIu32,
+                 submitted_in_interval * 1000000.0 / elapsed_us, total[LCD_FRAME_SUBMITTED],
+                 total[LCD_FRAME_JPEG_ERROR], total[LCD_FRAME_DRAW_ERROR]);
+        interval_start_us = now;
+        submitted_in_interval = 0;
+    }
+#else
+    (void)result;
+#endif
+}
+
+#if CONFIG_IDF_TARGET_ESP32P4
+static esp_err_t app_lcd_show_boot_pattern(void)
+{
+    if (s_lcd_width != 1024 || s_lcd_height != 600 ||
+            s_lcd_frame_format != DEV_DISPLAY_LCD_FRAME_FORMAT_RGB565_LE) {
+        return ESP_OK;
+    }
+    static const uint16_t colors[] = {
+        0xf800, 0x07e0, 0x001f, 0xffff, 0x0000, 0xffe0, 0x07ff, 0xf81f,
+    };
+    const size_t color_count = sizeof(colors) / sizeof(colors[0]);
+    void *framebuffer = NULL;
+    ESP_RETURN_ON_ERROR(esp_lcd_dpi_panel_get_frame_buffer(s_panel, 1, &framebuffer),
+                        TAG, "get DPI framebuffer for startup bars");
+    uint16_t *pixels = framebuffer;
+    for (size_t x = 0; x < s_lcd_width; x++) {
+        pixels[x] = colors[x * color_count / s_lcd_width];
+    }
+    const size_t row_bytes = s_lcd_width * sizeof(*pixels);
+    for (size_t y = 1; y < s_lcd_height; y++) {
+        memcpy(pixels + y * s_lcd_width, pixels, row_bytes);
+    }
+    // The DPI driver writes back the hardware framebuffer when submitted directly.
+    ESP_RETURN_ON_ERROR(esp_lcd_panel_draw_bitmap(s_panel, 0, 0, s_lcd_width, s_lcd_height, framebuffer),
+                        TAG, "submit startup bars");
+    ESP_LOGI(TAG, "LCD boot pattern submitted");
+    return ESP_OK;
+}
+#endif
