+        ESP_RETURN_ON_ERROR(app_lcd_show_boot_pattern(), TAG, "draw LCD boot pattern failed");
+    }
+#endif
     ESP_RETURN_ON_ERROR(app_lcd_backlight_set(100), TAG, "turn LCD backlight on failed");
     return ESP_OK;
 #endif
