# P4X v1.6 silicon, independent Serial/JTAG console and USB OTG HS display.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=n
CONFIG_ESP32P4_REV_MIN_300=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_TINYUSB_RHPORT_HS=y
CONFIG_TUSB_VID=0x303A
CONFIG_SECURE_FLASH_ENC_ENABLED=n
CONFIG_SECURE_BOOT=n
CONFIG_APP_REPRODUCIBLE_BUILD=y
